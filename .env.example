# SHAPI Environment Configuration
# Copy to .env and fill in your values

# Application
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
INVARIANT_EVALUATION_INTERVAL_SEC=60

# Database
DATABASE_URL=postgresql://shapi:shapi@localhost:5432/shapi?schema=public

# Security
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
API_KEY_PREFIX=shapi_
API_RATE_LIMIT_MAX=1000
API_RATE_LIMIT_WINDOW=1 minute
SHAPI_BOOTSTRAP_TOKEN=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3001/api/v1/auth/callback
OIDC_SCOPES=openid profile email
OIDC_DEFAULT_TENANT_SLUG=local-dev
# API key for SDK + dashboard + scripts (must exist in DB: `pnpm db:seed` stores it)
# Generate a real one per environment; the value below is dev-only
SHAPI_API_KEY=shapi_demo_local_d3v_k3y_9f2c

# Webhook Secrets (generate with: openssl rand -hex 32)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
GITHUB_WEBHOOK_SECRET=ghwebhook_your_github_webhook_secret
SENDGRID_WEBHOOK_SECRET=sgwebhook_your_sendgrid_webhook_secret
TWILIO_WEBHOOK_SECRET=twwebhook_your_twilio_webhook_secret

# GitHub App
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET_APP=your_github_app_webhook_secret
GITHUB_APP_INTEGRATION_ID=
# Optional local/operator token mode when a GitHub App is unavailable.
# Keep the repository allow-list explicit; never commit GITHUB_TOKEN.
GITHUB_TOKEN=
GITHUB_ACCOUNT_LOGIN=
GITHUB_REPOSITORIES=

# Frontend URLs
DASHBOARD_URL=http://localhost:5173
SHAPI_DASHBOARD_URL=http://localhost:8080
DEMO_SAAS_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# Production compose substitutions
POSTGRES_USER=shapi
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=shapi
VITE_API_URL=http://localhost:3001/api/v1
# Optional when using OIDC browser sessions; set a real key for API-key-only mode.
VITE_SHAPI_API_KEY=

# Stripe (for demo SaaS)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
