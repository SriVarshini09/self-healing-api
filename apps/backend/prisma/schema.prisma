// Prisma Schema for SHAPI Backend
// Run: npx prisma generate && npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Core Models
// ============================================================================

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  integrations  Integration[]
  apiKeys       APIKey[]
  trackedEvents TrackedEvent[]
  users         User[]
  alertDestinations AlertDestination[]
  invites       WorkspaceInvite[]
}

// An invitation to join a workspace. Only the SHA-256 hash of the link token
// is stored; it expires after 7 days and is deleted when accepted or revoked.
model WorkspaceInvite {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  role        TenantRole @default(OPERATOR)
  tokenHash   String     @unique
  invitedById String?
  invitedBy   User?      @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  createdAt   DateTime   @default(now())

  @@unique([tenantId, email])
}

model Integration {
  id              String   @id @default(uuid())
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  name            String
  type            IntegrationType
  config          Json
  webhookSecret   String?  @unique
  webhookEnabled  Boolean  @default(true)
  // Latest provider API version seen on webhooks (Stripe: event.api_version).
  providerApiVersion String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  webhookEvents   WebhookEvent[]
  invariants      Invariant[]
  incidents       Incident[]
  githubInstalls  GitHubInstallation[]
  driftConfig     DriftDetectionConfig?
  outcomeChecks   OutcomeCheck[]
  stripeEventShapes StripeEventShape[]
  stripeChanges   StripeChange[]

  @@index([type])
  @@index([tenantId])
}

enum IntegrationType {
  STRIPE
  GITHUB
  SENDGRID
  TWILIO
  CUSTOM
}

model WebhookEvent {
  id              String   @id @default(uuid())
  integrationId   String
  integration     Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  eventType       String
  providerEventId String?
  payload         Json
  headers         Json
  status          WebhookEventStatus @default(RECEIVED)
  receivedAt      DateTime @default(now())
  processedAt     DateTime?
  retryCount      Int      @default(0)
  errorMessage    String?
  correlationId   String?
  replayJobs      ReplayJob[]

  @@index([integrationId, receivedAt])
  @@index([correlationId])
  @@index([status])
  @@unique([integrationId, providerEventId])
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
}

model Invariant {
  id                    String   @id @default(uuid())
  integrationId         String
  integration           Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  name                  String
  description           String
  predicateExpression   String   @db.Text
  predicateDescription  String
  predicateExample      String?
  repairRepository      String?
  repairFilePath        String?
  repairRequiredChecks  String[] @default([])
  status                InvariantStatus @default(UNKNOWN)
  evaluationWindowSec   Int      @default(300)
  minSamples            Int      @default(10)
  expectedSuccessRate   Float    @default(0.99)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  lastEvaluatedAt       DateTime?

  evaluations InvariantEvaluation[]
  incidents   Incident[]
  driftResults DriftResult[]

  @@index([integrationId])
  @@index([status])
}

enum InvariantStatus {
  HEALTHY
  DEGRADED
  VIOLATED
  UNKNOWN
}

model InvariantEvaluation {
  id              String   @id @default(uuid())
  invariantId     String
  invariant       Invariant @relation(fields: [invariantId], references: [id], onDelete: Cascade)
  windowStart     DateTime
  windowEnd       DateTime
  totalSamples    Int
  passedSamples   Int
  successRate     Float
  status          InvariantStatus
  details         Json?
  createdAt       DateTime @default(now())

  @@unique([invariantId, windowStart, windowEnd])
  @@index([invariantId, windowStart])
}

model Incident {
  id              String   @id @default(uuid())
  integrationId   String
  integration     Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  invariantId     String?
  invariant       Invariant? @relation(fields: [invariantId], references: [id], onDelete: SetNull)
  title           String
  description     String   @db.Text
  severity        IncidentSeverity
  status          IncidentStatus @default(DETECTED)
  rootCause       String?  @db.Text
  suggestedFix    String?  @db.Text
  githubPrUrl     String?
  detectedAt      DateTime @default(now())
  triagedAt       DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  replayJobs      ReplayJob[]
  repairCandidates RepairCandidate[]
  githubPRs       GitHubPullRequest[]
  alertDeliveries AlertDelivery[]
  stripeChanges   StripeChange[]

  @@index([integrationId, status])
  @@index([invariantId])
  @@index([detectedAt])
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  DETECTED
  TRIAGED
  REPLAYING
  REPAIRED
  RESOLVED
  DISMISSED
}

model AlertDelivery {
  id             String              @id @default(uuid())
  incidentId     String
  incident       Incident            @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  channel        String              @default("webhook")
  status         AlertDeliveryStatus @default(PENDING)
  attempts       Int                 @default(0)
  nextAttemptAt  DateTime            @default(now())
  lastError      String?             @db.Text
  httpStatus     Int?
  deliveredAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([incidentId, channel])
  @@index([status, nextAttemptAt])
}

enum AlertDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  RETRYING
  FAILED
}

model DriftDetectionConfig {
  id                    String   @id @default(uuid())
  integrationId         String   @unique
  integration           Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  baselineWindowDays    Int      @default(30)
  detectionWindowHours  Int      @default(1)
  minDetectionSamples   Int      @default(50)
  significanceThreshold Float    @default(0.01)
  minEffectSize         Float    @default(0.5)
  enabled               Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model DriftResult {
  id              String   @id @default(uuid())
  invariantId     String
  invariant       Invariant @relation(fields: [invariantId], references: [id], onDelete: Cascade)
  detected        Boolean
  pValue          Float
  effectSize      Float
  baselineRate    Float
  currentRate     Float
  sampleSize      Int
  detectedAt      DateTime @default(now())

  @@index([invariantId, detectedAt])
  @@index([detected])
}

model ReplayJob {
  id                  String   @id @default(uuid())
  incidentId          String
  incident            Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  webhookEventId      String
  webhookEvent        WebhookEvent @relation(fields: [webhookEventId], references: [id], onDelete: Cascade)
  status              ReplayJobStatus @default(PENDING)
  fixCandidate        String   @db.Text
  result              ReplayJobResult?
  originalEvaluation  Json?
  replayEvaluation    Json?
  startedAt           DateTime?
  completedAt         DateTime?
  errorMessage        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([incidentId])
  @@index([status])
}

enum ReplayJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ReplayJobResult {
  PASSED
  FAILED
  ERROR
}

model RepairCandidate {
  id          String   @id @default(uuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type        RepairType
  description String   @db.Text
  diff        String?  @db.Text
  files       String[]
  repository  String?
  changes     Json?
  confidence  Float    @default(0.5)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([incidentId])
}

enum RepairType {
  CODE_CHANGE
  CONFIG_CHANGE
  WEBHOOK_RETRY
  MANUAL
}

model GitHubInstallation {
  id                  String   @id @default(uuid())
  integrationId       String
  integration         Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  githubInstallationId BigInt  @unique
  accountLogin        String
  accountType         String
  repositories        String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  prs GitHubPullRequest[]
}

model GitHubPullRequest {
  id              String   @id @default(uuid())
  incidentId      String
  incident        Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  installationId  String
  installation    GitHubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  repository      String
  prNumber        Int
  prUrl           String
  title           String
  status          GitHubPRStatus @default(OPEN)
  verified        Boolean  @default(false)
  verificationHeadSha String?
  verificationChecks Json?
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([installationId, repository, prNumber])
  @@index([incidentId])
}

enum GitHubPRStatus {
  OPEN
  MERGED
  CLOSED
  DRAFT
}

enum TenantRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

model User {
  id        String     @id @default(uuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issuer    String
  subject   String
  email     String
  name      String?
  role      TenantRole @default(OPERATOR)
  // scrypt hash for email/password accounts (issuer "shapi:password"); null for SSO users.
  passwordHash String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  sessions AuthSession[]
  passwordResetTokens PasswordResetToken[]
  invitesSent WorkspaceInvite[] @relation("InvitesSent")

  @@unique([issuer, subject])
  @@index([tenantId])
  @@index([email])
}

model AuthSession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionHash String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// One-time password reset link. Only the SHA-256 hash of the token is stored;
// it expires after an hour and is deleted when used.
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================================
// SDK / Analytics Models
// ============================================================================

model TrackedEvent {
  id              String   @id @default(uuid())
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  eventId         String
  integration     IntegrationType
  type            String
  payload         Json
  timestamp       DateTime @default(now())
  correlationId   String?
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([integration, type, timestamp])
  @@index([correlationId])
  @@index([timestamp])
  @@index([tenantId, timestamp])
  // Event ids are chosen by each workspace's own code, so two workspaces can use the same id.
  @@unique([tenantId, eventId])
}

model APIKey {
  id          String   @id @default(uuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  name        String
  keyHash     String   @unique
  prefix      String
  permissions String[]
  role        TenantRole @default(OPERATOR)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([prefix])
  @@index([tenantId])
}

// An outcome check proves a business outcome exists in the customer's own
// database after a provider event, e.g. invoice.payment_succeeded =>
// an active subscription row within deadlineSec. No SDK instrumentation.
model OutcomeCheck {
  id                 String   @id @default(uuid())
  integrationId      String
  integration        Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  name               String
  description        String   @default("")
  triggerEventType   String
  sqlQuery           String   @db.Text
  paramBindings      Json
  deadlineSec        Int      @default(300)
  // AES-256-GCM ciphertexts; never returned by the API.
  databaseUrlCipher  String   @db.Text
  stripeApiKeyCipher String?  @db.Text
  enabled            Boolean  @default(true)
  lastReconciledAt   DateTime?
  lastError          String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  runs OutcomeCheckRun[]

  @@index([integrationId])
  @@index([triggerEventType])
}

model OutcomeCheckRun {
  id            String   @id @default(uuid())
  checkId       String
  check         OutcomeCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  sourceEventId String
  source        OutcomeRunSource
  params        Json
  dueAt         DateTime
  status        OutcomeRunStatus @default(PENDING)
  attempts      Int      @default(0)
  checkedAt     DateTime?
  detail        String?  @db.Text
  createdAt     DateTime @default(now())

  @@unique([checkId, sourceEventId])
  @@index([status, dueAt])
  @@index([checkId, createdAt])
}

enum OutcomeRunSource {
  WEBHOOK
  RECONCILE
}

enum OutcomeRunStatus {
  PENDING
  PASSED
  FAILED
  ERROR
}

// Where a workspace wants incident alerts: a Slack incoming webhook or email
// recipients. Deliveries reuse the AlertDelivery outbox with channel
// "dest:<destinationId>:<detected|resolved>" (one per incident per event).
model AlertDestination {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind            AlertDestinationKind
  name            String
  // AES-256-GCM ciphertext of the Slack webhook URL; never returned by the API.
  slackUrlCipher  String?  @db.Text
  emails          String[] @default([])
  enabled         Boolean  @default(true)
  notifyResolved  Boolean  @default(true)
  lastDeliveredAt DateTime?
  lastError       String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

enum AlertDestinationKind {
  SLACK
  EMAIL
}

// Learned shape of one Stripe webhook event type: field paths and value-kind
// counts only, never values (see services/stripe-shape.ts).
model StripeEventShape {
  id            String   @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  eventType     String
  samples       Int      @default(0)
  paths         Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([integrationId, eventType])
}

// A change in what Stripe sends: a new API version, or a field that was always
// present disappearing or changing type.
model StripeChange {
  id               String   @id @default(uuid())
  integrationId    String
  integration      Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  incidentId       String?
  incident         Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  kind             StripeChangeKind
  eventType        String?
  path             String?
  before           String?
  after            String?
  apiVersion       String?
  sourceEventId    String?
  // Outcome checks that read this field (their bindings overlap the path).
  affectedCheckIds String[] @default([])
  detectedAt       DateTime @default(now())

  @@index([integrationId, detectedAt])
  @@index([incidentId])
}

enum StripeChangeKind {
  API_VERSION
  FIELD_REMOVED
  TYPE_CHANGED
}

// "Request an invite" from the public landing page. One row per email; a repeat
// request updates it. Used only to contact the person about the beta.
model InviteRequest {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  company   String?
  note      String?  @db.Text
  requests  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
