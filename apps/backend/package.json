{
  "name": "@shapi/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "e2e:outcomes": "tsx scripts/e2e-outcome-checks.ts",
    "e2e:onboarding": "tsx scripts/e2e-onboarding.ts",
    "stripe:live-test": "tsx scripts/stripe-live-test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^8.4.1",
    "@fastify/formbody": "^7.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.12.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@prisma/client": "^5.7.1",
    "@shapi/drift-detection": "workspace:*",
    "@shapi/github-integration": "workspace:^",
    "@shapi/invariant-engine": "workspace:^",
    "@shapi/outcome-checks": "workspace:*",
    "@shapi/repair-generation": "workspace:*",
    "@shapi/shared": "workspace:*",
    "crypto": "^1.0.1",
    "dotenv": "^18.0.0",
    "fastify": "^4.25.2",
    "fastify-plugin": "^4.5.1",
    "fastify-raw-body": "^4.3.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "stripe": "^22.6.2",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "pg": "^8.23.1",
    "prisma": "^5.7.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
