    "@playwright/test": "^1.63.0",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "pg": "^8.23.1",
