{
  "name": "@shapi/demo-saas",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e.ts",
    "typecheck": "tsc --noEmit",
    "simulate:success": "tsx scripts/simulate.ts success",
    "simulate:failure": "tsx scripts/simulate.ts failure",
    "simulate:drift": "tsx scripts/simulate.ts drift"
  },
  "dependencies": {
    "@shapi/sdk": "workspace:*",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
